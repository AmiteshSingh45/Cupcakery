# Backend Environment Configuration Example
# Copy this file to .env and fill in with your actual values
# Never commit .env files - they contain sensitive information

# Server Configuration
PORT=4000

# MongoDB Configuration
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_mongodb_username:your_mongodb_password@your_cluster.mongodb.net/?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_here_should_be_long_and_random

# Admin Configuration
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_EMAIL_PASS=your_app_specific_password_here

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_or_live_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# General Password (if used for other purposes)
PASSWORD=your_general_password_here

# Twilio Configuration (for WhatsApp notifications)
TWILIO_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+1234567890

# Admin WhatsApp Number (for notifications)
ADMIN_WHATSAPP_NUMBER=+91your_phone_number
