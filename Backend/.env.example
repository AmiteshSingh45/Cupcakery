# ─────────────────────────────────────────
# Chat Memory Configuration
# ─────────────────────────────────────────

# Number of previous messages to keep in memory
# Lower = less context, lower cost
# Higher = more context, higher cost
CHAT_MEMORY_LIMIT=10

# ═════════════════════════════════════════
# Notes for First Time Setup
# ═════════════════════════════════════════

# 1. GROQ_API_KEY is REQUIRED
#    - Create free account at console.groq.com
#    - Navigate to API keys section
#    - Create new API key
#    - Copy here

# 2. Test your setup by running:
#    npm run server
#    Then try /api/chat/chat endpoint

# 3. For production:
#    - Use environment variables in hosting platform
#    - Never commit real keys to git
#    - Use strong, unique API keys
#    - Monitor usage regularly

